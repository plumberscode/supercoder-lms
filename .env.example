# ==========================================
# SUPERCODER LMS - ENVIRONMENT VARIABLES
# ==========================================
# Salin file ini menjadi .env.local untuk konfigurasi lokal:
# cp .env.example .env.local

# ------------------------------------------
# 1. SUPABASE CONFIGURATION (Wajib)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------
# 2. SITE / APPLICATION URL (Opsional)
# ------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.supercoder.id

# ------------------------------------------
# 3. AI PROVIDER (DeepSeek / Gemini)
# ------------------------------------------
# Digunakan untuk AI Tutor, evaluasi coding challenge, CSS tester, dan AI hints
DEEPSEEK_API_KEY=your-deepseek-api-key
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------
# 4. EMAIL & NOTIFICATIONS (Nodemailer / SMTP)
# ------------------------------------------
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Supercoder <no-reply@supercoder.id>

# Alternatif provider Resend (opsional)
RESEND_API_KEY=your-resend-api-key

# ------------------------------------------
# 5. CLOUDINARY (Gambar Blog)
# ------------------------------------------
# Upload gambar artikel dilakukan di server (signed upload) ke folder "supercoder-blog"
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------
# 6. SEO AGENT (/admin/seo) — semua opsional
# ------------------------------------------
# Agent memakai DEEPSEEK_API_KEY di atas. Crawler, audit & Google Autocomplete gratis tanpa key.
# SERP live (lihat hasil Google, keyword gap ranking, prospek backlink). 2.500 kredit gratis: https://serper.dev
SERPER_API_KEY=
# Google Search Console via service account (gratis). Tambahkan email service account
# sebagai user (akses terbatas cukup) di properti GSC. Private key boleh satu baris dengan \n.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
# PageSpeed Insights (opsional, menambah kuota)
PAGESPEED_API_KEY=
